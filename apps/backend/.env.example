# Application
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Database (Local MongoDB by default, or Atlas MongoDB replica set)
MONGODB_URI=mongodb://127.0.0.1:27017/younora_dev

# Logging
LOG_LEVEL=debug

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

