# Application
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Database (Local MongoDB by default, or Atlas MongoDB replica set)
MONGODB_URI=mongodb://127.0.0.1:27017/younora_dev

# Logging
LOG_LEVEL=debug

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Auth & Security
JWT_ACCESS_SECRET=younora-super-secret-access-token-key-32chars-min!
JWT_REFRESH_SECRET=younora-super-secret-refresh-token-key-32chars-min!
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
BCRYPT_SALT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_TIME_MS=900000

# Super Admin Seed
SUPER_ADMIN_NAME="Super Admin"
SUPER_ADMIN_EMAIL=admin@younora.com
SUPER_ADMIN_PASSWORD=SuperAdmin@123456
